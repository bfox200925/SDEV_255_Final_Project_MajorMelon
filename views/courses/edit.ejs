<h3>Edit Course</h3>

<form action="/dashboard/edit-course/<%= course._id %>" method="POST">
  <label for="name">Course Name:</label>
  <input type="text" id="name" name="name" value="<%= course.name %>" required><br>

  <label for="description">Description:</label>
  <input type="text" id="description" name="description" value="<%= course.description %>" required><br>

  <label for="credits">Credits:</label>
  <input type="number" id="credits" name="credits" value="<%= course.credits %>" required><br>

  <!-- Add this field for subject area -->
  <label for="subjectArea">Subject Area:</label>
  <input type="text" id="subjectArea" name="subjectArea" value="<%= course.subjectArea %>" required><br>

  <label for="teacher">Instructor:</label>
  <input type="text" id="teacher" name="teacher" required><br>

  <button type="submit" class="btn">Update Course</button>
</form>





