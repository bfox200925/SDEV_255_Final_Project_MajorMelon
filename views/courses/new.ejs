<link rel="stylesheet" href="/css/styles.css">

<h1>Add New Course</h1>

<form action="/dashboard/add-course" method="POST"> <!-- Correct the form action for adding a new course -->
  
  <label for="name">Course Name:</label>
  <input type="text" id="name" name="name" required><br>

  <label for="description">Description:</label>
  <input type="text" id="description" name="description" required><br>

  <label for="credits">Credits:</label>
  <input type="number" id="credits" name="credits" required><br>

  <!-- Ensure subjectArea field is included -->
  <label for="subjectArea">Subject Area:</label>
  <input type="text" id="subjectArea" name="subjectArea" required><br>

  <!-- Instructor selection as dropdown -->
  <label for="teacher">Instructor:</label>
  <select id="teacher" name="teacher" required>
    <option value="">Select an Instructor</option> <!-- Default option -->
    <% teachers.forEach(teacher => { %>
      <option value="<%= teacher._id %>"><%= teacher.name %></option>
    <% }) %>
  </select><br>

  <button type="submit" class="btn">Add Course</button>
</form>




