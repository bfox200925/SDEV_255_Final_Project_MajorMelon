<!doctype html>
<html lang="en">
<head>
<!-- Required meta tags -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="/css/styles.css">
<title><%= title %></title>
</head>
<body>

<%- include('./partials/nav') %>

<section class="py-5">
    <div class="container">
      <h1 class="text-center mb-4">About MM University</h1>
      <p class="lead text-center">
        Welcome to the MM University! We are dedicated to providing high-quality education, fostering a community of learners, and shaping the future through our diverse and innovative programs.
      </p>

      <div class="row mt-5">
        <div class="col-md-6">
          <h3>Our Mission</h3>
          <p>
            Our mission is to empower students with the knowledge and skills necessary to succeed in today’s dynamic world. We are committed to fostering academic excellence, personal growth, and a spirit of inquiry that encourages lifelong learning.
          </p>
        </div>
        <div class="col-md-6">
          <h3>Our Vision</h3>
          <p>
            Our vision is to be a leading institution recognized globally for our excellence in education, research, and community engagement. We aim to inspire change, promote innovation, and contribute to the betterment of society.
          </p>
        </div>
      </div>

      <div class="row mt-5">
        <div class="col-md-4">
          <h4>Why Choose Us?</h4>
          <p>
            With state-of-the-art facilities, a dedicated faculty, and a comprehensive range of programs, the University of Major Melons offers a vibrant academic environment designed to help you succeed.
          </p>
        </div>
        <div class="col-md-4">
          <h4>Our Core Values</h4>
          <ul>
            <li class="core-value">
              <span class="letter">M</span>
              <span class="word">otivate</span>
            </li>
            <li class="core-value">
              <span class="letter">E</span>
              <span class="word">xcellence</span>
            </li>
            <li class="core-value">
              <span class="letter">L</span>
              <span class="word">eadership</span>
            </li>
            <li class="core-value">
              <span class="letter">O</span>
              <span class="word">utstanding</span>
            </li>
            <li class="core-value">
              <span class="letter">N</span>
              <span class="word">urturing</span>
            </li>
            <li class="core-value">
              <span class="letter">S</span>
              <span class="word">uccessful</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>



<%- include('./partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>


</body>
</html>